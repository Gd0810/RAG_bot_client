# -----------------------------------------------------------------------
# Copy this file to ".env" (same folder as manage.py) and fill in your key.
#     cp .env.example .env
# -----------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# -----------------------------------------------------------------------
# NVIDIA NIM (build.nvidia.com) - free hosted text generation models
# 1. Go to https://build.nvidia.com/models
# 2. Configure two separate models with two separate API keys (e.g. from 2 accounts)
# -----------------------------------------------------------------------
NVIDIA_API_BASE_URL=

# Primary model (Default)
NVIDIA_MODEL_PRIMARY=
NVIDIA_API_KEY_PRIMARY=

# Fallback model (Used automatically if primary model call fails/errors out)
NVIDIA_MODEL_FALLBACK=
NVIDIA_API_KEY_FALLBACK=

NVIDIA_REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------
# RAG tuning (optional - sensible defaults are already set)
# -----------------------------------------------------------------------
CHROMA_COLLECTION_NAME=organization_data
VECTOR_TOP_K=4
VECTOR_DISTANCE_THRESHOLD=0.90
PAGE_INDEX_TOP_K=3

# -----------------------------------------------------------------------
# SMTP Email Configuration (for Department Dashboard response emails)
# -----------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

